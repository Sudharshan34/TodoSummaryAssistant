{
  "title": "Todo App Overview",
  "uid": "todo-app-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "requests/s",
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"backend\"}[1m]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Error rate (5xx %)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{ "refId": "A", "legendFormat": "5xx %",
        "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"backend\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"backend\"}[5m]))" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Average latency",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "legendFormat": "avg latency",
        "expr": "sum(rate(http_server_requests_seconds_sum{job=\"backend\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"backend\"}[5m]))" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "CPU usage %",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{ "refId": "A", "legendFormat": "CPU",
        "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Memory usage %",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{ "refId": "A", "legendFormat": "Memory",
        "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100" }]
    },
    {
      "id": 6, "type": "gauge", "title": "Disk usage % (/)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 70 },
          { "color": "red", "value": 85 } ] } } },
      "targets": [{ "refId": "A", "legendFormat": "Disk",
        "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}) * 100" }]
    },
    {
      "id": 7, "type": "stat", "title": "Backend up (1 = yes)",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job=\"backend\"}" }]
    },
    {
      "id": 8, "type": "stat", "title": "Backend uptime",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "process_uptime_seconds{job=\"backend\"}" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Container restarts (last 1h)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{name}}",
        "expr": "changes(container_start_time_seconds{name=~\".+\"}[1h])" }]
    }
  ]
}